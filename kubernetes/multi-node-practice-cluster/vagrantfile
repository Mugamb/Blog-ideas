Vagrant.configure("2") do |config|
  config.vm.box = "cloud-image/ubuntu-22.04"
  config.vm.box_version = "20260918.0.0"
  config.vm.box_check_update = false

  # Shared folders are unnecessary for this Kubernetes lab.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  nodes = [
    { name: "control-plane", ip: "192.168.56.10", memory: 3072, cpus: 2 },
    { name: "worker-1",      ip: "192.168.56.11", memory: 2048, cpus: 1 },
    { name: "worker-2",      ip: "192.168.56.12", memory: 2048, cpus: 1 }
  ]

  nodes.each do |node|
    config.vm.define node[:name] do |machine|
      machine.vm.hostname = node[:name]
      machine.vm.network "private_network", ip: node[:ip]
      machine.vm.disk :disk, size: "20GB", primary: true
      machine.vm.provider "virtualbox" do |vb|
        vb.name = "k8s-#{node[:name]}"
        vb.memory = node[:memory]
        vb.cpus = node[:cpus]
        vb.gui = false
        vb.check_guest_additions = false

        # Required for VirtualBox guests using more than one CPU.
        vb.customize ["modifyvm", :id, "--ioapic", "on"]
      end

      # Local name resolution among the nodes (used for verification in this post).
      machine.vm.provision "shell", inline: <<-SHELL
        grep -qF "192.168.56.10 control-plane" /etc/hosts ||
          echo "192.168.56.10 control-plane" >> /etc/hosts

        grep -qF "192.168.56.11 worker-1" /etc/hosts ||
          echo "192.168.56.11 worker-1" >> /etc/hosts

        grep -qF "192.168.56.12 worker-2" /etc/hosts ||
          echo "192.168.56.12 worker-2" >> /etc/hosts
      SHELL
    end
  end
end
